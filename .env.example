# ─────────────────────────────────────────────────────────────────────────────
# TalentFlow AI configuration. Copy to `.env` and adjust:   cp .env.example .env
# Never commit `.env`. Every value below is a safe local-development default.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
# development | test | production. Production enables Secure cookies and disables /docs.
APP_ENV=development
APP_NAME="TalentFlow AI"
LOG_LEVEL=INFO
# Public URL of the web app (used in e-mail links and CORS).
FRONTEND_URL=http://localhost:3300
# Public URL of the API (only used in documentation links).
BACKEND_URL=http://localhost:8300
# Extra allowed CORS origins, comma separated. The frontend proxies /api, so normally none are needed.
CORS_ORIGINS=http://localhost:3300

# ── Database (PostgreSQL 16 + pgvector) ──────────────────────────────────────
POSTGRES_USER=talentflow
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=talentflow
# Inside Docker the host is `db`; from your Mac it is localhost:5436.
DATABASE_URL=postgresql+psycopg://talentflow:change-me-local-only@db:5432/talentflow

# ── Authentication / sessions ────────────────────────────────────────────────
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
SESSION_TTL_HOURS=336
# Leave empty locally; set to your domain in production if needed.
COOKIE_DOMAIN=

# ── AI provider ──────────────────────────────────────────────────────────────
# ollama  : local models through Ollama (default, free, CVs never leave your machine)
# openai  : any OpenAI-compatible API (OpenAI, Azure OpenAI, Mistral, vLLM, ...), needs AI_API_KEY
# none    : no AI. The app still works; AI features return a clear "not configured" error,
#           and only the seeded demo records get labelled, deterministic demo results.
AI_PROVIDER=ollama
AI_MODEL=qwen3:8b
# Ollama on the host machine, as seen from inside Docker.
AI_BASE_URL=http://host.docker.internal:11434
AI_API_KEY=
AI_TIMEOUT_SECONDS=300
# Embeddings for semantic matching. Empty EMBEDDING_PROVIDER = lexical matching only.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# ── Files ────────────────────────────────────────────────────────────────────
# Private storage directory (never served directly).
STORAGE_DIR=/data/storage
MAX_UPLOAD_MB=5
MAX_LOGO_MB=1

# ── E-mail ───────────────────────────────────────────────────────────────────
# smtp    : send through an SMTP server (local default: Mailpit, inbox at http://localhost:8325)
# console : don't send; only log that an e-mail was sent (never logs the link or token)
EMAIL_BACKEND=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM="TalentFlow AI <no-reply@talentflow.local>"

# ── Privacy / retention ──────────────────────────────────────────────────────
# Delete accounts that have been inactive this many days (0 = never).
INACTIVE_ACCOUNT_RETENTION_DAYS=0
# Delete AI usage records and finished background tasks older than this.
OPERATIONAL_LOG_RETENTION_DAYS=90

# ── Frontend ─────────────────────────────────────────────────────────────────
# Where the Next.js server forwards /api requests (inside Docker: the api service).
BACKEND_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_APP_NAME="TalentFlow AI"
